# Copy to .env and fill in values. Shell exports override .env.

# Unstructured (extract_tables_unstructured.py)
UNSTRUCTURED_API_KEY=

# Shared AWS credentials (extract_tables_bda.py, extract_tables_textract.py)
AWS_PROFILE=default
AWS_REGION=<region>

# Bedrock Data Automation (extract_tables_bda.py)
BDA_S3_UPLOAD_PATH=s3://<bucket-name>/bda-uploads/
BDA_DATA_AUTOMATION_PROJECT_ARN=arn:aws:bedrock:<region>:<account-id>:data-automation-project/<project-id>

# AWS Textract (extract_tables_textract.py)
TEXTRACT_S3_UPLOAD_PATH=s3://<bucket-name>/textract-uploads/
